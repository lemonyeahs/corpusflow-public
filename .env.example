# Placeholders only. Prefer: make init-env (generates local random credentials).
APP_ENV=development
POSTGRES_USER=corpusflow
POSTGRES_DB=corpusflow
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_RANDOM
DATABASE_URL=postgresql+psycopg://corpusflow:CHANGE_ME_LOCAL_RANDOM@127.0.0.1:55432/corpusflow
REDIS_PASSWORD=CHANGE_ME_LOCAL_RANDOM
REDIS_URL=redis://:CHANGE_ME_LOCAL_RANDOM@127.0.0.1:56379/0
OBJECT_STORE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORE_BUCKET=corpusflow-dev
OBJECT_STORE_ACCESS_KEY=CHANGE_ME_LOCAL_RANDOM
OBJECT_STORE_SECRET_KEY=CHANGE_ME_LOCAL_RANDOM
DEPENDENCY_TIMEOUT=2
# Training Center read-only catalog. Runtime query adapters arrive in M1.
TRAINING_CENTER_DATA_DIR=.local/training-center
TRAINING_CENTER_SNAPSHOT_TTL_SECONDS=900
TRAINING_CENTER_SNAPSHOT_MAX_PER_WORKSPACE=10
TRAINING_CENTER_MAX_RECORDS=100000
TRAINING_CENTER_MAX_BYTES=104857600
# Optional offline local embedding service; blank means unavailable.
EMBEDDING_ENDPOINT=
EMBEDDING_TIMEOUT=30
EMBEDDING_RETRIES=1
# Explicit administrator allowlist; no automatic external acquisition by default.
ACQUISITION_HOSTS=[]
# External generation is disabled until explicitly authorized for fixture workspaces.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_WORKSPACES=[]
LLM_MAX_CALLS=0
LLM_MAX_TOKENS=512
LLM_TIMEOUT=45
